@model IEnumerable<BLL.DTOs.RoomAllocationDTO>

<div class="d-flex justify-content-between align-items-center bg-light p-3 mb-4 rounded shadow-sm">
    <div class="w-100">
        <a asp-controller="Resident" asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
        <a asp-controller="Resident" asp-action="ProfileDetails" asp- class="btn btn-primary">Profile</a>
    </div>

    <div class="w-100 text-center">
        <a asp-controller="Resident" asp-action="BookRoom" class="btn btn-outline-primary mx-2">Book Room</a>
        @* <a href="#" class="btn btn-outline-primary mx-2">Meals</a> *@
        <a asp-controller="Resident" asp-action="Bills" class="btn btn-outline-primary mx-2">Bills & Expenses</a>
    </div>

    <div class="w-100 text-end">
        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">Logout</a>
    </div>
</div>



<div class="container mt-4">

    <h3 class="mb-4">
        Pending Room Requests
    </h3>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>Allocation ID</th>
                    <th>RoomNumber</th>
                    <th>Allocation Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if(Model.Any())
                {
                    @foreach(var item in Model)
                    {
                        <tr>

                            <td>@item.AllocationId</td>

                            <td>@item.RoomNumber</td>

                            <td>@item.AllocationDate</td>

                            <td>@item.Status</td>
                            <td> <a asp-controller="Resident" asp-action="CancelBooking" asp-route-roomId="@item.RoomId" class="btn btn-danger">Cancel</a></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4"
                            class="text-center text-muted">
                            No pending room requests found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>