@model List<BLL.DTOs.NotificationDTO>

<div class="d-flex justify-content-between align-items-center bg-light p-3 mb-4 rounded shadow-sm">

    <div class="w-25">
        <a asp-controller="Resident" asp-action="Dashboard" class="btn btn-primary">Dashboard</a>
        <a asp-controller="Resident" asp-action="ProfileDetails" class="btn btn-primary">Profile</a>
    </div>

    <div class="w-50 d-flex justify-content-center gap-2">
        <a asp-controller="Resident" asp-action="BookRoom" class="btn btn-outline-primary">Book Room</a>
        @* <a href="#" class="btn btn-outline-primary">Meals</a> *@
        <a asp-controller="Resident" asp-action="Bills" class="btn btn-outline-primary">Bills & Expenses</a>
        <a asp-controller="Resident" asp-action="Notifications" class="btn btn-primary text-nowrap">
            Notifications (@ViewBag.UnreadCount)
        </a>
    </div>

    <div class="w-25 text-end">
        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">Logout</a>
    </div>

</div>

<h2 class="mb-4">My Notifications</h2>

<table class="table table-bordered">

    <thead class="table-dark">

        <tr>
            <th>Title</th>
            <th>Message</th>
            <th>Date</th>
            <th>Status</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Title</td>

                <td>@item.Message</td>

                <td>
                    @(item.CreatedAt?.ToString("dd MMM yyyy hh:mm tt"))
                </td>

                <td>
                    @(item.IsRead ? "Read" : "Unread")
                </td>

            </tr>
        }

    </tbody>

</table>