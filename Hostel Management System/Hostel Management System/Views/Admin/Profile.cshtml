@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = "Admin Profile";
}
<div class="d-flex justify-content-between align-items-center bg-light p-3 mb-4 rounded shadow-sm">

    <div>
        <a href="#" class="btn btn-secondary">Profile</a>
    </div>

    <div>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">Logout</a>
    </div>
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4><i class="bi bi-person-circle"></i> My Profile</h4>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th scope="row" class="text-muted">Full Name</th>
                                <td class="fw-bold">@Model.FullName</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Email</th>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Phone Number</th>
                                <td>@Model.Phone</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Gender</th>
                                <td>@(string.IsNullOrEmpty(Model.Gender) ? "Not Specified" : Model.Gender)</td>
                            </tr>
                            <tr>
                                <th scope="row" class="text-muted">Account Type</th>
                                <td><span class="badge bg-success">Administrator</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Dashboard" class="btn btn-secondary">Back</a>
                    <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning">Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>