    <div class="col-md-4">
        <input type="text" id="searchInput"class="form-control border border-black" placeholder="Search users..." />
    </div>
</div> *@
            <div class="row mt-4">
            
                <div class="col-md-3">
                    <div class="card p-3">
                        <h5>Total Revenue</h5>
                        <h3>@ViewBag.TotalRevenue</h3>
                    </div>
                </div>
            
                <div class="col-md-3">
                    <div class="card p-3">
                        <h5>Total Due</h5>
                        <h3>@ViewBag.TotalDue</h3>
                    </div>
                </div>
            
                <div class="col-md-3">
                    <div class="card p-3">
                        <h5>Total Expenses</h5>
                        <h3>@ViewBag.TotalExpense</h3>
                    </div>
                </div>
            
                <div class="col-md-3">
                    <div class="card p-3">
                        <h5>Profit</h5>
                        <h3>@ViewBag.TotalProfit</h3>
                    </div>
                </div>
            
            </div>

        <form method="get" asp-action="Dashboard" asp-controller="Admin" class="mb-3 ">

            <div class="row justify-content-end pt-2">
                <div class="col-md-4 ">
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border border-black" placeholder="Search by Name, Student ID or Email" />
                </div>

                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>
                </div>
            </div>
        </form>






<div class="container-fluid">
    <h3 class="mb-3">Registered Users</h3>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover" id="userTable">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Student ID</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>Profile</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@(string.IsNullOrEmpty(user.StudentId) ? "N/A" : user.StudentId)</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>@user.Gender</td>
                            <td>
                                <a asp-controller="Admin" asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Admin" asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No users found in the system.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
 