<div class="container d-flex justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <h2 class="text-center mb-4">Edit Expense</h2>

        <form method="post" class="shadow-sm p-4 bg-white rounded border">
            <input type="hidden" asp-for="ExpenseId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Title</label>
                <input asp-for="ExpenseTitle" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Category</label>
                <input asp-for="ExpenseCategory" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Amount</label>
                <input asp-for="Amount" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-success w-100">
                    Save Changes
                </button>
            </div>
        </form>

    </div>
</div>