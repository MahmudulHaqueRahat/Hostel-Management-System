@model List<BLL.DTOs.ExpenseDTO>
<div class="d-flex justify-content-between align-items-center bg-light p-3 mb-4 rounded shadow-sm">

    <div>
        <a asp-controller="Admin" asp-action="Profile" class="btn btn-secondary">Profile</a>
    </div>

    <div class="text-center">
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary mx-2">Users</a>
        <a asp-controller="Admin" asp-action="Room" class="btn btn-outline-primary mx-2">Rooms</a>
        <a asp-controller="Admin" asp-action="Bills" class="btn btn-outline-primary mx-2">Bills</a>
        <a asp-controller="Admin" asp-action="GenerateBills" class="btn btn-outline-primary">
            Generate Bills
        </a>
        <a asp-controller="Admin" asp-action="Expenses" class="btn btn-primary mx-2">
            Expenses
        </a>

    </div>

    <div>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">Logout</a>
    </div>
</div>

<h2>Expenses</h2>

<p>
    <a asp-action="CreateExpense"
       class="btn btn-primary">
        Add Expense
    </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Amount</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExpenseTitle</td>
                <td>@item.ExpenseCategory</td>
                <td>@item.Amount</td>
                <td>@item.ExpenseDate</td>

                <td>
                    <a asp-action="EditExpense"
                       asp-route-id="@item.ExpenseId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="DeleteExpense"
                       asp-route-id="@item.ExpenseId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>